    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(weed_http_response_bytes_total{instance=~\"$instance\"}[$__rate_interval])) or vector(0)) + (sum(rate(weed_tpc_bytes_total{instance=~\"$instance\",mode=\"push\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "egress"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(weed_upload_bytes_total{instance=~\"$instance\"}[$__rate_interval])) or vector(0)) + (sum(rate(weed_tpc_bytes_total{instance=~\"$instance\",mode=\"pull\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "ingress"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "description": "Egress: downloads and third-party copies that weed pushes. Ingress: uploads (counted when they complete) and third-party copies that weed pulls.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
