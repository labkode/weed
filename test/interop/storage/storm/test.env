# StoRM tells a third-party copy with itself from one with another server by the
# hostname: it is the pod's, as weed is on localhost
STORAGE_URL=davs://storage.interop.test:8543/interop
READY_TIMEOUT=180
# StoRM gives macaroons, which gfal2 asks it for when weed is to copy from or to it, only
# to clients with a VOMS proxy
VOMS=interop
