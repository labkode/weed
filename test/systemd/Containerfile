# systemd as PID 1, as on weed's target, AlmaLinux 10 (systemd 257: Type=notify-reload
# needs 253 or later), for make test-systemd; and rpmbuild, which builds weed's RPM
FROM almalinux:10
# A mirror may serve broken metadata for a while ("repomd.xml parser error"): dnf
# reads only the repositories it needs, and tries again
RUN for i in 1 2 3 4; do \
        dnf install -y --repo=baseos --repo=appstream --allowerasing --setopt=install_weak_deps=False \
            systemd dbus util-linux shadow-utils procps-ng curl jq diffutils logrotate \
            rpm-build systemd-rpm-macros && break; \
        [ $i = 4 ] && exit 1; dnf -q clean metadata; sleep $((i * 15)); \
    done && \
    dnf clean all && \
    systemctl mask getty.target console-getty.service systemd-firstboot.service \
        systemd-udevd.service systemd-udev-trigger.service systemd-hwdb-update.service \
        systemd-modules-load.service
CMD ["/sbin/init"]
